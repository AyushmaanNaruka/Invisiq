# InvisiQ edge-function secrets (Phase 1).
#
# Set these on the deployed project with:
#   supabase secrets set --env-file supabase/.env   (copy this file to .env first)
# or individually:
#   supabase secrets set FRAGMENT_SECRET=...
#
# NOTE: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are
# auto-injected into the edge runtime by the platform — do NOT set them here
# (names prefixed with SUPABASE_ are reserved and will be rejected).

# Signs the offline-decrypt fragment: unlockFragment = HMAC(FRAGMENT_SECRET, user.id).
# Long random string. CHANGING THIS INVALIDATES EVERY ACTIVE USER'S DERIVED KEY.
FRAGMENT_SECRET=replace-with-a-long-random-secret

# Signs server-stamped session tokens (offline grace).
SESSION_SIGNING_SECRET=replace-with-a-different-long-random-secret

# Optional overrides (defaults shown).
TRIAL_DAYS=14
SESSION_TTL_HOURS=24
