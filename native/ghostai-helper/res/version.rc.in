// Version resource — configured by CMake (@VAR@ substitution).
// Publisher identity is parametrized so the disguise-vs-honest-cert decision
// can be flipped without touching source.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @HELPER_VERSION_COMMA@
 PRODUCTVERSION @HELPER_VERSION_COMMA@
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@HELPER_COMPANY_NAME@"
            VALUE "FileDescription",  "@HELPER_FILE_DESC@"
            VALUE "FileVersion",      "@HELPER_VERSION@"
            VALUE "InternalName",     "ghostai_helper"
            VALUE "OriginalFilename", "ghostai_helper.exe"
            VALUE "ProductName",      "@HELPER_PRODUCT_NAME@"
            VALUE "ProductVersion",   "@HELPER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
