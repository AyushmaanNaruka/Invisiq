{
  "name": "runtimebroker",
  "version": "1.2.2",
  "description": "InvisiQ",
  "main": "./out/main/index.js",
  "author": "InvisiQ",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build:helper": "node scripts/build-helper.js",
    "gen:installer-assets": "electron scripts/gen-installer-assets.cjs sidebar && electron scripts/gen-installer-assets.cjs header",
    "verify": "npx ts-node scripts/verify-build.ts",
    "package": "npm run build:helper && electron-vite build && electron-builder --win",
    "package:dir": "npm run build:helper && electron-vite build && electron-builder --win --dir",
    "publish": "npm run build:helper && electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.35.0",
    "@google/generative-ai": "^0.21.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.18.2",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.460.0",
    "node-machine-id": "^1.1.12",
    "openai": "^4.75.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "tesseract.js": "^5.1.1",
    "uiohook-napi": "^1.5.5",
    "uuid": "^10.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.3"
  }
}
